 neutron/agent/l3/ha.py                        |  9 ----
 neutron/agent/l3/ha_router.py                 | 32 ++----------
 neutron/agent/l3/router_info.py               | 20 +++-----
 neutron/agent/linux/interface.py              | 50 +++++--------------
 .../unit/agent/l3/test_dvr_local_router.py    |  1 -
 .../tests/unit/agent/linux/test_interface.py  | 16 ------
 7 files changed, 24 insertions(+), 108 deletions(-)

